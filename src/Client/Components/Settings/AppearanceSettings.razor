@using DotGPT.Core.Interfaces
@using DotGPT.Core.Models
@inject ISettingsService SettingsService

<h2>Appearance Settings</h2>

<div class="settings-section">
    <h3>Theme</h3>
    <div class="form-check mb-2">
        <input class="form-check-input" type="radio" name="themeOptions" id="lightTheme" 
               checked="@(settings.Theme == "Light")" 
               @onclick="@(() => UpdateTheme("Light"))" />
        <label class="form-check-label" for="lightTheme">
            Light
        </label>
    </div>
    <div class="form-check mb-2">
        <input class="form-check-input" type="radio" name="themeOptions" id="darkTheme" 
               checked="@(settings.Theme == "Dark")" 
               @onclick="@(() => UpdateTheme("Dark"))" />
        <label class="form-check-label" for="darkTheme">
            Dark
        </label>
    </div>
    <div class="form-check mb-3">
        <input class="form-check-input" type="radio" name="themeOptions" id="systemTheme" 
               checked="@(settings.Theme == "System")" 
               @onclick="@(() => UpdateTheme("System"))" />
        <label class="form-check-label" for="systemTheme">
            System default
        </label>
    </div>
</div>

<div class="settings-section">
    <h3>Font Size</h3>
    <div class="mb-3">
        <label for="fontSizeRange" class="form-label">Adjust font size: @settings.FontSize px</label>
        <input type="range" class="form-range" min="12" max="24" id="fontSizeRange"
               @bind="settings.FontSize" @bind:after="SaveSettings">
        <div class="d-flex justify-content-between">
            <span>Small</span>
            <span>Medium</span>
            <span>Large</span>
        </div>
    </div>
</div>

<div class="settings-section">
    <h3>Chat Bubbles</h3>
    <div class="form-check form-switch mb-3">
        <input class="form-check-input" type="checkbox" id="compactMode"
               @bind="settings.CompactMode" @bind:after="SaveSettings">
        <label class="form-check-label" for="compactMode">Compact mode</label>
    </div>
    
    <div class="mb-3">
        <label for="colorScheme" class="form-label">Color scheme</label>
        <select class="form-select" id="colorScheme"
                @bind="settings.ColorScheme" @bind:after="SaveSettings">
            <option value="Default">Default</option>
            <option value="Blue">Blue</option>
            <option value="Green">Green</option>
            <option value="Purple">Purple</option>
        </select>
    </div>
</div>

@code {
    private UserSettings settings = new UserSettings();

    protected override async Task OnInitializedAsync()
    {
        settings = await SettingsService.GetSettingsAsync();
    }

    private async Task SaveSettings()
    {
        await SettingsService.SaveSettingsAsync(settings);
        await ApplyThemeChanges();
    }
    
    private async Task UpdateTheme(string theme)
    {
        settings.Theme = theme;
        await SaveSettings();
    }

    private async Task ApplyThemeChanges()
    {
        // Additional functionality to apply theme changes can be added here
        // This would typically involve invoking JavaScript to change CSS variables or class names
    }
}